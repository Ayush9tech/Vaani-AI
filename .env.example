# Server-only. Never put API keys into a frontend bundle.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
POSTGRES_PASSWORD=vaani-local-only
DATABASE_URL=postgresql+psycopg://vaani:vaani-local-only@localhost:5432/vaani
ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
# Optional hosted Sites proxy to a separately deployed FastAPI service.
FASTAPI_URL=

# NextAuth Configuration
AUTH_SECRET="your_nextauth_secret_32_chars_long"

# Google OAuth (For Google Login)
AUTH_GOOGLE_ID="your_google_client_id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your_google_client_secret"

# Nodemailer / SMTP Configuration (App Password Technique)
# Replace with your Gmail and a generated 16-character App Password (no spaces)
EMAIL_SERVER="smtp://your-email@gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:587"
EMAIL_FROM="your-email@gmail.com"
